rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.role == 'admin';
    }

    function isStaff() {
      return isAuthenticated() && 
        (request.auth.token.role == 'staff' || isAdmin());
    }

    function isOwner(userId) {
      return isAuthenticated() && 
        (request.auth.uid == userId || 
         (request.auth.token.docId != null && request.auth.token.docId == userId));
    }

    // OTP material — strictly isolated to Cloud Functions (Admin SDK)
    match /phone_otps/{doc=**} {
      allow read, write: if false;
    }

    // Staff accounts
    match /staff/{staffId} {
      // Staff and Admin can view staff profiles for store operations
      allow read: if isStaff();
      // Only Admin can create or delete staff records
      allow create, delete: if isAdmin();
      // Staff and Admin can update operational metrics (sales count, lastActive, store settings)
      allow update: if isStaff();
    }

    // Users collection
    match /users/{userId} {
      // Allow users to read their own data; staff/admin can read
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isStaff());
      // Strictly deny all creates, updates, and deletes from the client side!
      // All writes must happen only through Cloud Functions via Firebase Admin SDK.
      allow write: if false;
    }

    // Customers collection
    match /Customers/{customerId} {
      // Staff/Admin can view all customers for POS/lookup; customer can ONLY view own profile
      allow read: if isStaff() || isOwner(customerId);

      // Staff or Admin can register in-store customers; online signups handled via Cloud Function
      allow create: if isStaff() || isAdmin();

      // Updates:
      // STRICTLY BLOCK customer direct updates from the client side!
      // All customer profile modifications must go through secure Cloud Functions (updateUserProfile).
      // Only Staff and Admin are permitted direct POS operational updates.
      allow update: if isStaff() || isAdmin();

      // Only Admin can delete customer records
      allow delete: if isAdmin();
    }

    // Customer-owned shopping data. Keep this explicit: a recursive wildcard
    // here would let a customer create or modify arbitrary nested documents.
    match /Customers/{customerId}/cart/{cartId} {
      allow read, write: if isStaff() || isOwner(customerId);
    }

    match /Customers/{customerId}/wishlist/{wishlistId} {
      allow read, write: if isStaff() || isOwner(customerId);
    }

    // No other customer subcollections are client-writable by default.
    match /Customers/{customerId}/{allSubcollections=**} {
      allow read, write: if isStaff();
    }

    // CollectionGroup for cart management
    match /{path=**}/cart/{docId} {
      allow read: if isStaff() || isAdmin();
    }

    // Sales transactions & Customer history
    match /Sales/{saleId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow write: if isStaff();
    }

    match /CustomerTx/{txId} {
      allow read: if isStaff() || (
        isAuthenticated() && (
          resource.data.customerId == request.auth.uid ||
          (request.auth.token.customerMobile != null && resource.data.customerMobile == request.auth.token.customerMobile) ||
          (request.auth.token.phone_number != null && request.auth.token.phone_number.matches('.*' + resource.data.customerMobile + '$'))
        )
      );
      allow write: if isStaff();
    }

    match /AccountTx/{txId} {
      allow read, write: if isStaff();
    }

    match /Activity/{activityId} {
      allow read: if isStaff() || (
        isAuthenticated() && (
          (request.auth.token.customerMobile != null && resource.data.customerMobile == request.auth.token.customerMobile) ||
          (request.auth.token.phone_number != null && request.auth.token.phone_number.matches('.*' + resource.data.customerMobile + '$'))
        )
      );
      allow create: if isStaff() || (
        isAuthenticated() && (
          request.auth.token.customerMobile == null || 
          request.resource.data.customerMobile == request.auth.token.customerMobile
        )
      );
      allow update, delete: if isStaff() || isAdmin();
    }

    // Seva Pool
    match /SevaPool/{poolId} {
      allow read: if true;
      allow write: if isStaff() || isAdmin();
    }

    // Public catalog (Products, Categories, Stores, Banners, Settings)
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /origins/{originId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventory/{invId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // E-commerce orders
    match /orders/{orderId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff() || (
        isAuthenticated() && 
        resource.data.userId == request.auth.uid && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId',
          'status', 
          'paymentStatus', 
          'totalAmount', 
          'items', 
          'adminCut', 
          'adminProfit',
          'paymentDetails'
        ])
      );
      allow delete: if isAdmin();
    }

    // Payment logs — only Cloud Functions with Admin SDK may write
    match /payments/{paymentId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Default fallback: unauthenticated clients cannot read/write any other document
    match /{document=**} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
  }
}
